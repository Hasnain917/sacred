            {
              "id": "8782a5b",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style='color: #576059; font-size: 16px; line-height: 1.85;'>Kambo is a traditional Amazonian medicine that comes from the secretion of the Phyllomedusa bicolor frog. It is used to cleanse the body, mind, and spirit. This powerful frog secretion helps detoxify, boost immunity, and release deep-seated emotional blockages. Our ceremonies honor the indigenous roots of Kambo, offering a safe, deeply held, and supportive space for renewal.</p>"
              },
              "elements": []
